# ─────────────────────────────────────────────────────────────────────────────
# SplitFree — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and should NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (https://supabase.com → Settings → API) ─────────────────────────
# Public keys — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Secret key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Google One Tap (https://console.cloud.google.com → APIs & Services → Credentials) ─
# Use the same OAuth 2.0 Client ID configured for Supabase's Google provider.
# Client IDs are public identifiers — safe to expose to the browser.
# Add your site's origin(s) under "Authorized JavaScript origins" for this client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── MongoDB Atlas (https://cloud.mongodb.com → Connect → Drivers) ─────────────
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=splitfree

# ── App URL ───────────────────────────────────────────────────────────────────
# Local development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
